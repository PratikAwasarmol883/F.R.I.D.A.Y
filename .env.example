# FRIDAY Environment Configuration
# Copy this file to .env and fill in actual values for local development
# NEVER commit .env with real secrets

# Application
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://friday_user:friday_password@localhost:5433/friday_db
SQLALCHEMY_ECHO=false

# Server
HOST=0.0.0.0
PORT=8000

# CORS (for development)
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Optional: LLM Provider (add when needed for Milestone 1)
# OPENAI_API_KEY=sk-<your-key-here>
# OPENAI_MODEL=gpt-4-turbo-preview

# Optional: Search Provider (add when needed for Milestone 2)
# TAVILY_API_KEY=<your-key-here>

# Optional: Speech Services (add when needed for Milestone 5)
# STT_PROVIDER=openai  # or google, azure
# TTS_PROVIDER=openai  # or google, azure
