# FRIDAY Environment Configuration
# Copy this file to .env and fill in actual values for local development
# NEVER commit .env with real secrets

# Application
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://friday_user:friday_password@localhost:5433/friday_db
SQLALCHEMY_ECHO=false

# Server
HOST=0.0.0.0
PORT=8000

# CORS (for development)
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# LLM provider (required for /api/v1/assistant/ask; the app starts without it but ask returns 503)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
MAX_HISTORY_MESSAGES=20
DAILY_TOKEN_BUDGET=200000

# Tools (Milestone 2). A tool only exists if its provider key is set, and each device also needs the
# matching scope (python -m friday.cli register-device ... --scopes tool:web_search).
ENABLED_TOOLS=web_search,web_fetch,remember
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
TOOL_TIMEOUT_SECONDS=10
MAX_TOOL_CALLS_PER_ASK=3
SEARCH_MAX_RESULTS=5
SEARCH_DAILY_LIMIT=50
ASK_DEADLINE_SECONDS=60

# Background tasks (Milestone 3). Run the worker with: python -m friday.worker (Compose: friday-worker).
MAX_ACTIVE_TASKS_PER_USER=5
TASK_WORKER_CONCURRENCY=2
TASK_POLL_INTERVAL_SECONDS=2
TASK_LEASE_SECONDS=60          # must be greater than 2x TASK_HEARTBEAT_SECONDS
TASK_HEARTBEAT_SECONDS=10
TASK_MAX_ATTEMPTS=3
TASK_MAX_RUNTIME_SECONDS=300
TASK_RETRY_BASE_SECONDS=5
TASK_RETRY_MAX_SECONDS=120
TASK_RETENTION_DAYS=30
TASK_SHUTDOWN_GRACE_SECONDS=30

# Research reports (Milestone 4). Needs SEARCH_API_KEY, ENABLED_TOOLS to include web_fetch, and a device
# registered with: --scopes tool:web_search,tool:web_fetch
FETCH_TIMEOUT_SECONDS=10
FETCH_DAILY_LIMIT=100
RESEARCH_MAX_SEARCHES=3
RESEARCH_MAX_SOURCES=5
RESEARCH_MAX_OUTPUT_TOKENS=3000
RESEARCH_DEADLINE_SECONDS=240

# Voice (Milestone 5). Any OpenAI-compatible speech API works (OpenAI, Groq, local Whisper servers).
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.openai.com/v1   # https only (http allowed for localhost)
STT_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
VOICE_MAX_UPLOAD_BYTES=6000000
VOICE_DAILY_LIMIT=100
VOICE_TTS_MAX_CHARS=1500
VOICE_TIMEOUT_SECONDS=30

# Memory and schedules (Milestone 6)
MEMORY_ENABLED=true
MEMORY_IN_PROMPT=true                 # false = notes are stored but never sent to the model
MEMORY_MAX_NOTES=200
MEMORY_MAX_PENDING=20
MAX_SCHEDULES_PER_USER=10
SCHEDULE_GRACE_SECONDS=3600           # occurrences later than this are skipped, never backfilled
SCHEDULER_BATCH=20
